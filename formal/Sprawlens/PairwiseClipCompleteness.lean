import Sprawlens.FiniteMassTransport
import Sprawlens.TriangleBoundaryClipCompleteness

namespace Sprawlens.PairwiseClipCompleteness

open scoped BigOperators

open CanonicalClip
open ClipCompleteness
open ConvexClipContract
open ConvexClipConsequences
open ExactGeometry
open HalfPlaneClipPoints
open HalfPlaneIntersection
open SimpleRing
open Vec2Linear

universe u

variable {R : Type u} [Field R] [LinearOrder R] [IsStrictOrderedRing R]

/-- Declarative generators that allow a crossing between any two input
vertices, not only adjacent polygon vertices. -/
def IsPairwiseClipGenerator {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    (point : Vec2 R) : Prop :=
  (∃ index,
    point = vertex index ∧ signedDistance plane (vertex index) ≤ 0) ∨
  (∃ first second,
    point = boundaryPoint plane (vertex first) (vertex second) ∧
      ((signedDistance plane (vertex first) ≤ 0 ∧
          0 < signedDistance plane (vertex second)) ∨
        (0 < signedDistance plane (vertex first) ∧
          signedDistance plane (vertex second) ≤ 0)))

/-- Convex region generated by retained vertices and all crossing chords. -/
def pairwiseClipGeneratorConvexRegion {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) :
    Set (Vec2 R) :=
  convexHull R { point | IsPairwiseClipGenerator plane vertex point }

/-- The algebraic completeness obligation before using polygon adjacency. -/
def PairwiseGeneratorHullComplete {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) : Prop :=
  indexedVertexConvexRegion vertex ∩ halfPlaneRegion plane ⊆
    pairwiseClipGeneratorConvexRegion plane vertex

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- Signed distance commutes with any finite affine combination. -/
theorem signedDistance_finite_affineCombination
    {Index : Type} [Fintype Index]
    (plane : HalfPlane R) (weight : Index → R) (point : Index → Vec2 R)
    (target : Vec2 R) (weightSum : ∑ index, weight index = 1)
    (pointEq : ∑ index, weight index • point index = target) :
    ∑ index, weight index * signedDistance plane (point index) =
      signedDistance plane target := by
  let xHom : Vec2 R →+ R :=
    { toFun := Vec2.x
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  let yHom : Vec2 R →+ R :=
    { toFun := Vec2.y
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  have pointEqX : ∑ index, weight index * (point index).x = target.x := by
    change ∑ index, xHom (weight index • point index) = xHom target
    rw [← map_sum]
    exact congrArg xHom pointEq
  have pointEqY : ∑ index, weight index * (point index).y = target.y := by
    change ∑ index, yHom (weight index • point index) = yHom target
    rw [← map_sum]
    exact congrArg yHom pointEq
  simp only [signedDistance]
  simp_rw [show ∀ index,
      weight index *
          (plane.normalX * (point index).x +
            plane.normalY * (point index).y - plane.offset) =
        plane.normalX * (weight index * (point index).x) +
            plane.normalY * (weight index * (point index).y) -
          plane.offset * weight index by
    intro index
    ring]
  rw [Finset.sum_sub_distrib, Finset.sum_add_distrib]
  rw [← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
  rw [pointEqX, pointEqY, weightSum]
  ring

/-- Pure finite-weight transport contract: every retained affine combination
can be rewritten using pairwise clipping generators. -/
def PairwiseBarycentricTransport {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) : Prop :=
  ∀ {Input : Type} [Fintype Input]
    (weight : Input → R) (source : Input → RingIndex extraVertices),
    (∀ index, 0 ≤ weight index) →
    (∑ index, weight index) = 1 →
    (∑ index,
      weight index * signedDistance plane (vertex (source index))) ≤ 0 →
    ∃ (Output : Type) (_ : Fintype Output)
      (outputWeight : Output → R) (outputPoint : Output → Vec2 R),
      (∀ index, 0 ≤ outputWeight index) ∧
      (∑ index, outputWeight index) = 1 ∧
      (∀ index, IsPairwiseClipGenerator plane vertex (outputPoint index)) ∧
      (∑ index, outputWeight index • outputPoint index) =
        ∑ index, weight index • vertex (source index)

/-- Finite barycentric transport implies all-pairs generator completeness. -/
theorem pairwiseGeneratorHullComplete_of_barycentricTransport
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    (transport : PairwiseBarycentricTransport plane vertex) :
    PairwiseGeneratorHullComplete plane vertex := by
  intro target targetMember
  obtain ⟨Input, _, weight, inputPoint,
      weightNonnegative, weightSum, inputPointMember, pointEq⟩ :=
    mem_convexHull_iff_exists_fintype.mp targetMember.1
  choose source sourceEq using fun index ↦ Set.mem_range.mp (inputPointMember index)
  have inputCenterEq :
      ∑ index, weight index • vertex (source index) = target := by
    calc
      ∑ index, weight index • vertex (source index) =
          ∑ index, weight index • inputPoint index := by
            apply Finset.sum_congr rfl
            intro index _
            rw [sourceEq index]
      _ = target := pointEq
  have weightedDistanceInside :
      ∑ index,
        weight index * signedDistance plane (vertex (source index)) ≤ 0 := by
    rw [signedDistance_finite_affineCombination plane weight
      (fun index ↦ vertex (source index)) target weightSum inputCenterEq]
    exact targetMember.2
  obtain ⟨Output, _, outputWeight, outputPoint,
      outputWeightNonnegative, outputWeightSum, outputGenerators,
      outputEq⟩ := transport weight source weightNonnegative weightSum
    weightedDistanceInside
  unfold pairwiseClipGeneratorConvexRegion
  apply mem_convexHull_of_exists_fintype outputWeight outputPoint
    outputWeightNonnegative outputWeightSum outputGenerators
  exact outputEq.trans inputCenterEq

/-- Conversely, all-pairs region completeness provides a finite barycentric
transport witness for every retained affine combination. -/
theorem pairwiseBarycentricTransport_of_generatorHullComplete
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    (complete : PairwiseGeneratorHullComplete plane vertex) :
    PairwiseBarycentricTransport plane vertex := by
  intro Input _ weight source weightNonnegative weightSum
    weightedDistanceInside
  let target := ∑ index, weight index • vertex (source index)
  have targetInInput : target ∈ indexedVertexConvexRegion vertex := by
    unfold indexedVertexConvexRegion
    apply mem_convexHull_of_exists_fintype weight
      (fun index ↦ vertex (source index)) weightNonnegative weightSum
    · intro index
      exact Set.mem_range_self (source index)
    · rfl
  have targetInHalfPlane : target ∈ halfPlaneRegion plane := by
    change signedDistance plane target ≤ 0
    rw [← signedDistance_finite_affineCombination plane weight
      (fun index ↦ vertex (source index)) target weightSum rfl]
    exact weightedDistanceInside
  have targetInPairwise := complete ⟨targetInInput, targetInHalfPlane⟩
  unfold pairwiseClipGeneratorConvexRegion at targetInPairwise
  obtain ⟨Output, _, outputWeight, outputPoint,
      outputWeightNonnegative, outputWeightSum, outputGenerators,
      outputEq⟩ := mem_convexHull_iff_exists_fintype.mp targetInPairwise
  exact ⟨Output, inferInstance, outputWeight, outputPoint,
    outputWeightNonnegative, outputWeightSum, outputGenerators, outputEq⟩

/-- Pairwise region completeness and finite barycentric transport are exactly
the same algebraic obligation. -/
theorem pairwiseGeneratorHullComplete_iff_barycentricTransport
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) :
    PairwiseGeneratorHullComplete plane vertex ↔
      PairwiseBarycentricTransport plane vertex := by
  exact ⟨pairwiseBarycentricTransport_of_generatorHullComplete plane vertex,
    pairwiseGeneratorHullComplete_of_barycentricTransport plane vertex⟩

omit [IsStrictOrderedRing R] in
/-- Every actual adjacent-edge boundary generator is also a pairwise
generator. -/
theorem boundaryGenerator_isPairwise {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    {point : Vec2 R}
    (generator : IsClipBoundaryGenerator plane vertex point) :
    IsPairwiseClipGenerator plane vertex point := by
  rcases generator with retained | crossing
  · exact Or.inl retained
  · rcases crossing with ⟨index, pointEq, crossing⟩
    exact Or.inr ⟨index, nextIndex index, pointEq, crossing⟩

omit [IsStrictOrderedRing R] in
/-- The actual emitter's pure output region is contained in the all-pairs
relaxation. -/
theorem clipBoundaryGeneratorConvexRegion_subset_pairwise {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) :
    clipBoundaryGeneratorConvexRegion plane vertex ⊆
      pairwiseClipGeneratorConvexRegion plane vertex := by
  unfold clipBoundaryGeneratorConvexRegion pairwiseClipGeneratorConvexRegion
  apply convexHull_mono
  intro point generator
  exact boundaryGenerator_isPairwise plane vertex generator

/-- Every pairwise generator lies in the input vertex convex hull and on the
retained side of the clipping half-plane. This needs no polygon ordering. -/
theorem pairwiseGenerator_mem_inputConvexIntersection {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    {point : Vec2 R}
    (generator : IsPairwiseClipGenerator plane vertex point) :
    point ∈ indexedVertexConvexRegion vertex ∩ halfPlaneRegion plane := by
  rcases generator with retained | crossing
  · rcases retained with ⟨index, rfl, inside⟩
    exact ⟨subset_convexHull R _ (Set.mem_range_self index), inside⟩
  · rcases crossing with ⟨first, second, rfl, crossing⟩
    rcases crossing with insideOutside | outsideInside
    · let parameter := boundaryParameter
          (signedDistance plane (vertex first))
          (signedDistance plane (vertex second))
      have parameterRange := boundaryParameter_mem_Icc_of_inside_outside
        insideOutside.1 insideOutside.2
      have inputMember :
          boundaryPoint plane (vertex first) (vertex second) ∈
            indexedVertexConvexRegion vertex := by
        rw [show boundaryPoint plane (vertex first) (vertex second) =
            interpolatePoint (vertex first) (vertex second) parameter by rfl]
        rw [← affineCombination_eq_interpolatePoint
          (vertex first) (vertex second) (1 - parameter) parameter (by ring)]
        exact (convex_convexHull R (Set.range vertex))
          (subset_convexHull R _ (Set.mem_range_self first))
          (subset_convexHull R _ (Set.mem_range_self second))
          (sub_nonneg.mpr parameterRange.2) parameterRange.1 (by ring)
      have boundaryDistance :
          signedDistance plane
            (boundaryPoint plane (vertex first) (vertex second)) = 0 := by
        apply signedDistance_boundaryPoint
        intro equalDistance
        linarith
      exact ⟨inputMember, le_of_eq boundaryDistance⟩
    · let parameter := boundaryParameter
          (signedDistance plane (vertex first))
          (signedDistance plane (vertex second))
      have parameterRange := boundaryParameter_mem_Icc_of_outside_inside
        outsideInside.1 outsideInside.2
      have inputMember :
          boundaryPoint plane (vertex first) (vertex second) ∈
            indexedVertexConvexRegion vertex := by
        rw [show boundaryPoint plane (vertex first) (vertex second) =
            interpolatePoint (vertex first) (vertex second) parameter by rfl]
        rw [← affineCombination_eq_interpolatePoint
          (vertex first) (vertex second) (1 - parameter) parameter (by ring)]
        exact (convex_convexHull R (Set.range vertex))
          (subset_convexHull R _ (Set.mem_range_self first))
          (subset_convexHull R _ (Set.mem_range_self second))
          (sub_nonneg.mpr parameterRange.2) parameterRange.1 (by ring)
      have boundaryDistance :
          signedDistance plane
            (boundaryPoint plane (vertex first) (vertex second)) = 0 := by
        apply signedDistance_boundaryPoint
        intro equalDistance
        linarith
      exact ⟨inputMember, le_of_eq boundaryDistance⟩

/-- The entire all-pairs generator hull is sound. -/
theorem pairwiseClipGeneratorConvexRegion_subset_inputConvexIntersection
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) :
    pairwiseClipGeneratorConvexRegion plane vertex ⊆
      indexedVertexConvexRegion vertex ∩ halfPlaneRegion plane := by
  apply convexHull_min
  · intro point generator
    exact pairwiseGenerator_mem_inputConvexIntersection plane vertex generator
  · exact (convex_convexHull R (Set.range vertex)).inter
      (halfPlaneRegion_convex plane)

/-- Pairwise completeness is equivalent to exact equality because pairwise
soundness is unconditional. -/
theorem pairwiseClipGeneratorConvexRegion_eq_iff_complete
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R) :
    pairwiseClipGeneratorConvexRegion plane vertex =
        indexedVertexConvexRegion vertex ∩ halfPlaneRegion plane ↔
      PairwiseGeneratorHullComplete plane vertex := by
  constructor
  · intro regionEq
    unfold PairwiseGeneratorHullComplete
    rw [regionEq]
  · intro complete
    exact Set.Subset.antisymm
      (pairwiseClipGeneratorConvexRegion_subset_inputConvexIntersection
        plane vertex)
      complete

/-- Once algebraic all-pairs completeness is available, actual executable
completeness is equivalent to the single geometric obligation that all chord
crossings are covered by the adjacent-edge generator hull. -/
theorem boundaryGeneratorHullComplete_iff_pairwiseCovered
    {extraVertices : Nat}
    (plane : HalfPlane R) (vertex : RingIndex extraVertices → Vec2 R)
    (pairwiseComplete : PairwiseGeneratorHullComplete plane vertex) :
    BoundaryGeneratorHullComplete plane vertex ↔
      pairwiseClipGeneratorConvexRegion plane vertex ⊆
        clipBoundaryGeneratorConvexRegion plane vertex := by
  constructor
  · intro boundaryComplete point pairwiseMember
    exact boundaryComplete
      (pairwiseClipGeneratorConvexRegion_subset_inputConvexIntersection
        plane vertex pairwiseMember)
  · intro pairwiseCovered point pointMember
    exact pairwiseCovered (pairwiseComplete pointMember)

end Sprawlens.PairwiseClipCompleteness
