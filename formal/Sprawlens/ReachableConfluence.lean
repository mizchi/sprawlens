import Sprawlens.LayoutConfluence

namespace Sprawlens.ReachableConfluence

open LayoutConfluence

universe u v

/-- A layout state is relevant to one experiment when some finite edit prefix
reaches it from the declared initial state. -/
def Reachable {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (initial state : State) : Prop :=
  ∃ edits, runEdits apply edits initial = state

/-- Local commutation restricted to states reachable from one initial layout. -/
def ReachableLocalCommute {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State) : Prop :=
  ∀ first second, Independent first second →
    ∀ state, Reachable apply initial state →
      apply second (apply first state) = apply first (apply second state)

/-- Every pair of traces generated by independent adjacent swaps has the same
final state when executed from this particular initial layout. -/
def TraceIndependentFrom {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State) : Prop :=
  ∀ {first second}, TraceEquivalent Independent first second →
    runEdits apply first initial = runEdits apply second initial

/-- Reachable local diamonds are sufficient for global trace independence from
the fixed initial layout. The swapped square is reached by the common prefix. -/
theorem traceIndependentFrom_of_reachableLocalCommute
    {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State)
    (localCommute : ReachableLocalCommute apply Independent initial) :
    TraceIndependentFrom apply Independent initial := by
  intro first second equivalent
  induction equivalent with
  | refl => rfl
  | swap before after first second independent =>
      rw [runEdits_append, runEdits_append]
      simp only [runEdits]
      rw [localCommute first second independent
        (runEdits apply before initial) ⟨before, rfl⟩]
  | symm _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ leftHypothesis rightHypothesis =>
      exact leftHypothesis.trans rightHypothesis

/-- Global trace independence from one initial layout forces every independent
square at every reachable state to commute. A failing reachable square can be
embedded after its reaching prefix. -/
theorem reachableLocalCommute_of_traceIndependentFrom
    {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State)
    (traceIndependent : TraceIndependentFrom apply Independent initial) :
    ReachableLocalCommute apply Independent initial := by
  intro first second independent state reachable
  rcases reachable with ⟨before, rfl⟩
  simpa [runEdits_append, runEdits] using
    (traceIndependent
      (TraceEquivalent.swap before [] first second independent))

/-- Exact characterization: fixed-initial trace independence is equivalent to
commutation of all declared-independent pairs on the reachable state space. -/
theorem traceIndependentFrom_iff_reachableLocalCommute
    {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State) :
    TraceIndependentFrom apply Independent initial ↔
      ReachableLocalCommute apply Independent initial := by
  constructor
  · exact reachableLocalCommute_of_traceIndependentFrom
      apply Independent initial
  · exact traceIndependentFrom_of_reachableLocalCommute
      apply Independent initial

/-- One noncommuting reachable square is a complete refutation witness for
fixed-initial trace independence. -/
theorem not_traceIndependentFrom_of_reachable_noncommuting_square
    {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial state : State) (first second : Edit)
    (independent : Independent first second)
    (reachable : Reachable apply initial state)
    (different : apply second (apply first state) ≠
      apply first (apply second state)) :
    ¬ TraceIndependentFrom apply Independent initial := by
  intro traceIndependent
  exact different
    (reachableLocalCommute_of_traceIndependentFrom
      apply Independent initial traceIndependent
      first second independent state reachable)

/-- Universal commutation remains a convenient stronger sufficient condition. -/
theorem reachableLocalCommute_of_universal
    {Edit : Type u} {State : Type v}
    (apply : Edit → State → State) (Independent : Edit → Edit → Prop)
    (initial : State)
    (universal : ∀ first second, Independent first second →
      Commute apply first second) :
    ReachableLocalCommute apply Independent initial := by
  intro first second independent state _
  exact universal first second independent state

/-- A finite witness showing why unreachable states must not be required. -/
inductive ReachabilityEdit
  | first
  | second
  deriving DecidableEq, Repr

inductive ReachabilityState
  | initial
  | left
  | right
  deriving DecidableEq, Repr

def applyReachabilityEdit : ReachabilityEdit → ReachabilityState → ReachabilityState
  | _, .initial => .initial
  | .first, .left => .right
  | .first, .right => .right
  | .second, .left => .left
  | .second, .right => .left

def AllIndependent : ReachabilityEdit → ReachabilityEdit → Prop :=
  fun _ _ => True

theorem reachability_initial_absorbing (edits : List ReachabilityEdit) :
    runEdits applyReachabilityEdit edits .initial = .initial := by
  induction edits with
  | nil => rfl
  | cons edit rest inductionHypothesis =>
      simp only [runEdits, applyReachabilityEdit]
      exact inductionHypothesis

/-- All edit orders agree from the absorbing initial state. -/
theorem reachability_traceIndependentFrom_initial :
    TraceIndependentFrom applyReachabilityEdit AllIndependent .initial := by
  intro first second _
  rw [reachability_initial_absorbing, reachability_initial_absorbing]

/-- Yet the same edits fail to commute at an unreachable state. Thus universal
all-state commutation is strictly stronger than the reachable condition. -/
theorem reachability_not_universal_commute :
    ¬ Commute applyReachabilityEdit .first .second := by
  intro universal
  have atLeft := universal .left
  simp [applyReachabilityEdit] at atLeft

theorem reachability_reachableLocalCommute_initial :
    ReachableLocalCommute applyReachabilityEdit AllIndependent .initial := by
  exact reachableLocalCommute_of_traceIndependentFrom
    applyReachabilityEdit AllIndependent .initial
    reachability_traceIndependentFrom_initial

end Sprawlens.ReachableConfluence
